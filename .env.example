# Database
DATABASE_URL="postgresql://learn:learn@localhost:5432/learning_saas"

# Redis (BullMQ)
REDIS_URL="redis://127.0.0.1:6379"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Optional: S3-compatible storage for snapshots (leave empty to skip uploads)
S3_ENDPOINT=""
S3_REGION=""
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# Optional: OpenAI for embeddings / card text
OPENAI_API_KEY=""

# Optional: Clerk (omit for dev demo mode)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""
CLERK_SECRET_KEY=""

# Demo org fallback when Clerk is not configured
DEMO_ORG_SLUG="demo-org"
