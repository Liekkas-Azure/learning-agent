# Database
# Docker Compose（Postgres）— 需将 packages/db/prisma/schema.prisma 中 provider 设为 postgresql
# DATABASE_URL="postgresql://learn:learn@localhost:5432/learning_saas"
# 本地无 Docker 时可用 SQLite（默认 schema 为 sqlite）
DATABASE_URL="file:./dev.db"

# Redis (BullMQ)
REDIS_URL="redis://127.0.0.1:6379"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# 拆分的独立前端（学习主站顶栏「知识库 / 港股」外链；不设则隐藏对应入口）
NEXT_PUBLIC_VAULT_APP_URL="http://localhost:3020"
NEXT_PUBLIC_HK_APP_URL="http://localhost:3030"
# 知识库 PWA 底栏「学习」跳转（不设则底栏该项为灰色占位）
NEXT_PUBLIC_LEARNING_APP_URL="http://localhost:3000"

# Optional: S3-compatible storage for snapshots (leave empty to skip uploads)
S3_ENDPOINT=""
S3_REGION=""
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# Optional: 博查 AI 网页搜索（国内），用于「智能采集资料」挑选网页种子
# 文档: https://open.bocha.cn/
BOCHA_API_KEY=""

# Optional: OpenAI for embeddings / card text
OPENAI_API_KEY=""

# 港股看板新闻：默认调用方舟 Responses API（/api/v3/responses）。关闭：`HK_NEWS_USE_LLM=0`
# DOUBAO_API_KEY=""
# DOUBAO_MODEL="doubao-seed-2-0-pro-260215"
# DOUBAO_API_BASE="https://ark.cn-beijing.volces.com/api/v3"
ARK_API_KEY=""
ARK_MODEL=""
# Knotory 闪卡配图：方舟「文生图」推理接入点 ID（ep- 开头，与 ARK_MODEL 分开）
# ARK_IMAGE_MODEL=ep-xxxxxxxx-xxxxx
ARK_MODEL="doubao-seed-2-0-pro-260215"

# Optional: Clerk (omit for dev demo mode)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""
CLERK_SECRET_KEY=""

# Demo org fallback when Clerk is not configured
DEMO_ORG_SLUG="demo-org"

# Docker Compose 生产端口映射（见 DEPLOY.md；容器内固定 3040/3030/3020，左侧为宿主机端口）
# LEARNING_WEB_PORT=3040
# LEARNING_HK_PORT=3030
# LEARNING_VAULT_PORT=3020
