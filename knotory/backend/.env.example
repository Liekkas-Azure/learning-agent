# Knotory 后端 — 复制为 backend/.env 后按需填写

# —— 存储（默认云端 S3；本地开发可设 KNOTORY_STORAGE_BACKEND=local）——
KNOTORY_STORAGE_BACKEND=s3
# S3 模式下本地工作缓存（启动时从云端拉取，写入后即时上传）
KNOTORY_CACHE_DIR=/tmp/knotory-cache
# local 模式下的数据目录（s3 模式可忽略）
KNOTORY_DATA_DIR=~/knotory-data
# 留空则自动使用数据目录下的 knotory.db
# KNOTORY_DB_PATH=

# S3 兼容对象存储（AWS S3 / Cloudflare R2 / 阿里云 OSS / MinIO）
# KNOTORY_S3_ENDPOINT_URL=https://xxx.r2.cloudflarestorage.com
# KNOTORY_S3_BUCKET=my-knotory-corpus
# KNOTORY_S3_PREFIX=knotory
# KNOTORY_S3_ACCESS_KEY_ID=
# KNOTORY_S3_SECRET_ACCESS_KEY=
# KNOTORY_S3_REGION=auto

KNOTORY_LOG_LEVEL=INFO

# —— 生产 / 公网 ——
# 设置后除 /health 与 OpenAPI 外均需 Bearer 鉴权；个人自托管可留空，开箱即用
# KNOTORY_API_KEY=
# 逗号分隔；生产请设为前端站点来源，勿使用 *
# KNOTORY_CORS_ORIGINS=https://knotory.example.com
# KNOTORY_MAX_UPLOAD_BYTES=33554432
# KNOTORY_UPLOAD_RATE_LIMIT_PER_MIN=12
# KNOTORY_TRUSTED_HOSTS=knotory.example.com,api.knotory.example.com
# 生产可关闭 OpenAPI 暴露
# KNOTORY_DISABLE_OPENAPI=true

# 云端试用（官方托管实例）
# KNOTORY_CLOUD_DEMO_URL=http://47.116.125.156:3010
# KNOTORY_IS_CLOUD_DEMO=true

# Cloud 多租户：开启后 API 需用户 JWT，文库按 user_id 隔离
# KNOTORY_AUTH_REQUIRED=true
# KNOTORY_JWT_SECRET=请更换为随机长字符串
# KNOTORY_WAITLIST_RATE_LIMIT_PER_MIN=8

# 问答闪卡（需 ARK 或 KNOTORY_CLOUD_*）
# KNOTORY_FLASHCARD_LLM_ENABLED=true
# KNOTORY_FLASHCARD_QA_PER_SECTION=2
# KNOTORY_FLASHCARD_MIN_CARDS_PER_WIKI=20
# KNOTORY_FLASHCARD_SECTION_MIN_CHARS=900
# KNOTORY_FLASHCARD_SECTION_MAX_LEVEL=1
# KNOTORY_FLASHCARD_MAX_SECTIONS_PER_WIKI=150
# KNOTORY_FLASHCARD_LARGE_DOC_CHARS=25000
# KNOTORY_FLASHCARD_TARGET_CHARS_PER_CARD=1500
# KNOTORY_FLASHCARD_LLM_MAX_SECTIONS=36
# KNOTORY_FLASHCARD_SECTION_CHARS=6000

# LLM：方舟（推荐）或 OpenAI 兼容
# ARK_API_KEY=
# ARK_MODEL=doubao-seed-2-0-pro-260215
# 闪卡文生图：必须填控制台创建的「推理接入点 ID」（ep- 开头），不要填公开模型名
# 在 https://console.volcengine.com/ark 开通 Seedream 并创建文生图接入点后复制 ID
# ARK_IMAGE_MODEL=ep-xxxxxxxx-xxxxx
# KNOTORY_FLASHCARD_IMAGE_MAX_PER_SYNC=10
# KNOTORY_FLASHCARD_IMAGE_SIZE=1024x1024
# KNOTORY_CLOUD_API_KEY=
# KNOTORY_CLOUD_BASE_URL=
# KNOTORY_CLOUD_MODEL=gpt-4o-mini

# KNOTORY_WATCH_CRON_ENABLED=false
# KNOTORY_WATCH_CRON_HOUR=5
# KNOTORY_WATCH_CRON_MINUTE=30

# 定时语料 zip 备份（需 scheduler 启用）
# KNOTORY_BACKUP_CRON_ENABLED=false
# KNOTORY_BACKUP_CRON_HOUR=4
# KNOTORY_BACKUP_CRON_MINUTE=0

# Neo4j（可选）
# KNOTORY_NEO4J_URI=bolt://127.0.0.1:7687
# KNOTORY_NEO4J_USER=neo4j
# KNOTORY_NEO4J_PASSWORD=

# 长期记忆 / Hybrid RAG / Learning Agent
# KNOTORY_VECTOR_BACKEND=local   # local | milvus
# KNOTORY_MILVUS_URI=
# KNOTORY_MILVUS_COLLECTION=knotory_chunks
# KNOTORY_EMBEDDING_MODEL=       # 空则本地哈希向量；可填方舟 embedding 接入点
# KNOTORY_EMBEDDING_DIM=384
# KNOTORY_HYBRID_VECTOR_WEIGHT=0.55
# KNOTORY_LEARNING_AGENT_ENABLED=true
# GRU-DKT：按用户交互序列在线训练并持久化 checkpoint
# KNOTORY_DKT_ENABLED=true
# KNOTORY_DKT_SKILL_BUCKETS=256
# KNOTORY_DKT_HIDDEN_SIZE=48
# KNOTORY_DKT_SEQUENCE_LENGTH=256
# KNOTORY_DKT_ONLINE_EPOCHS=3
