# Knotory 前端 — 复制为 frontend/.env.local 或 frontend/.env.production.local

# 浏览器访问 API 的根地址。生产仅开 3010 时可留空（走同域 + Next rewrites 反代）
# NEXT_PUBLIC_API_BASE=http://47.116.125.156:3010

# 服务端构建/SSR 反代目标（与 systemd 中 KNOTORY_BACKEND_URL 一致）
# KNOTORY_BACKEND_URL=http://127.0.0.1:8000

# 与后端 KNOTORY_API_KEY 相同；个人自托管留空即可
# NEXT_PUBLIC_KNOTORY_API_KEY=

# 官方云端试用 URL（自托管未配 LLM 时引导用户；云端实例自身也设为同一地址）
# NEXT_PUBLIC_KNOTORY_CLOUD_DEMO_URL=http://47.116.125.156:3010
# NEXT_PUBLIC_KNOTORY_IS_CLOUD_DEMO=true
# NEXT_PUBLIC_KNOTORY_AUTH_REQUIRED=true
